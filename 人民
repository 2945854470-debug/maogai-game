                    dialogue: '',
                    options: []
                }
            ]
        }
    };

    // ==================== 渲染场景 ====================
    function renderScene() {
        const contentDiv = document.getElementById('dynamicContent');
        const scene = scenes[gameState.currentScene];
        if (!scene) return;

        if (gameState.currentScene === 'ending') {
            renderEnding(contentDiv);
            return;
        }

        const step = scene.steps[gameState.currentStep];
        if (!step) {
            const sceneKeys = Object.keys(scenes);
            const currentIndex = sceneKeys.indexOf(gameState.currentScene);
            if (currentIndex < sceneKeys.length - 1) {
                gameState.currentScene = sceneKeys[currentIndex + 1];
                gameState.currentStep = 0;
                renderScene();
            } else {
                gameState.currentScene = 'ending';
                renderScene();
            }
            return;
        }

        let html = `
            <div class="scene-header">
                <h2>${scene.title}</h2>
            </div>
            <div class="scene-content">
                <div class="scene-image-placeholder">${step.imagePlaceholder || '📜 历史场景'}</div>
                <div class="dialogue-box">${step.dialogue}</div>
                <div class="options-area" id="optionsArea"></div>
            </div>
        `;
        contentDiv.innerHTML = html;

        const optionsArea = document.getElementById('optionsArea');
        if (step.options && step.options.length > 0) {
            step.options.forEach((opt, index) => {
                const btn = document.createElement('button');
                btn.className = 'option-btn';
                btn.innerHTML = `<span class="option-icon">${opt.icon || '▶'}</span><span>${opt.text}</span>`;
                btn.onclick = () => {
                    // 禁用所有选项按钮，防止重复点击
                    const allBtns = optionsArea.querySelectorAll('.option-btn');
                    allBtns.forEach(b => b.disabled = true);
                    applyChoice(opt.impact, opt.feedback, opt.relic, opt.next);
                };
                optionsArea.appendChild(btn);
            });
        } else {
            // 没有选项，直接显示继续按钮进入下一步
            const continueBtn = document.createElement('button');
            continueBtn.className = 'continue-btn';
            continueBtn.textContent = '继续前行 →';
            continueBtn.onclick = () => {
                const sceneKeys = Object.keys(scenes);
                const currentIndex = sceneKeys.indexOf(gameState.currentScene);
                if (currentIndex < sceneKeys.length - 1) {
                    gameState.currentScene = sceneKeys[currentIndex + 1];
                    gameState.currentStep = 0;
                } else {
                    gameState.currentScene = 'ending';
                }
                renderScene();
            };
            document.querySelector('.scene-content').appendChild(continueBtn);
        }
    }

    // ==================== 应用选择 ====================
    function applyChoice(impact, feedbackText, relic = null, nextStep = null) {
        gameState.peopleHeart = Math.min(100, Math.max(0, gameState.peopleHeart + impact));
        updateBalanceUI();

        gameState.history.push({
            scene: gameState.currentScene,
            step: gameState.currentStep,
            impact: impact,
            feedback: feedbackText
        });

        if (relic && !gameState.relics.includes(relic)) {
            gameState.relics.push(relic);
        }

        const sceneContent = document.querySelector('.scene-content');
        if (!sceneContent) return;

        const oldFeedback = sceneContent.querySelector('.feedback-message');
        if (oldFeedback) oldFeedback.remove();
        const oldContinue = sceneContent.querySelector('.continue-btn');
        if (oldContinue) oldContinue.remove();

        const feedbackDiv = document.createElement('div');
        feedbackDiv.className = 'feedback-message';
        feedbackDiv.innerHTML = feedbackText;

        if (relic) {
            const relicBadge = document.createElement('div');
            relicBadge.className = 'relic-badge';
            relicBadge.innerHTML = `<span>📜</span> 获得文物：${relic}`;
            feedbackDiv.appendChild(relicBadge);
        }

        sceneContent.appendChild(feedbackDiv);

        // 确定下一步
        let targetScene = gameState.currentScene;
        let targetStep = gameState.currentStep + 1;

        if (nextStep) {
            if (nextStep.scene) targetScene = nextStep.scene;
            if (nextStep.step !== undefined) targetStep = nextStep.step;
        } else {
            // 自动推进：如果当前步骤已是最后一步，进入下一场景
            const scene = scenes[gameState.currentScene];
            if (scene && targetStep >= scene.steps.length) {
                const sceneKeys = Object.keys(scenes);
                const currentIndex = sceneKeys.indexOf(gameState.currentScene);
                if (currentIndex < sceneKeys.length - 1) {
                    targetScene = sceneKeys[currentIndex + 1];
                    targetStep = 0;
                } else {
                    targetScene = 'ending';
                    targetStep = 0;
                }
            }
        }

        const continueBtn = document.createElement('button');
        continueBtn.className = 'continue-btn';
        continueBtn.textContent = '继续前行 →';
        continueBtn.onclick = () => {
            gameState.currentScene = targetScene;
            gameState.currentStep = targetStep;
            renderScene();
        };
        sceneContent.appendChild(continueBtn);
    }

    // ==================== 渲染结局 ====================
    function renderEnding(contentDiv) {
        const heart = gameState.peopleHeart;
        let endTitle = '';
        let endQuote = '';
        let endColor = '#7a411a';

        if (heart >= 80) {
            endTitle = '🏆 人民领袖';
            endQuote = '“我将无我，不负人民。”你用实际行动诠释了什么是人民至上。你始终把人民放在心中最高位置，赢得了人民的信任与支持。';
            endColor = '#b1420b';
        } else if (heart >= 60) {
            endTitle = '✅ 合格答卷人';
            endQuote = '你始终把人民放在心中，但仍有提升空间。人民满意是最高标准，继续努力，把好事实事做到群众心坎上。';
            endColor = '#6b4c27';
        } else {
            endTitle = '⚠️ 历史警钟';
            endQuote = '“水能载舟，亦能覆舟。”脱离群众是最大的危险。请重新审视每一个选择，把人民放在心中最高位置。';
            endColor = '#8b1a1a';
        }

        const relicsHtml = gameState.relics.length > 0
            ? gameState.relics.map(r => `<span style="display:inline-block; background:#d9b382; padding:4px 12px; border-radius:20px; margin:4px; font-size:0.85rem; font-weight:600;">📜 ${r}</span>`).join('')
            : '<span style="color:#999;">未收集到文物</span>';

        contentDiv.innerHTML = `
            <div class="end-screen">
                <div class="end-title" style="color:${endColor};">${endTitle}</div>
                <div class="end-quote">${endQuote}</div>
                <div class="score-summary">
                    <p><span>❤️ 最终民心值</span><strong>${Math.round(heart)}</strong></p>
                    <p><span>📜 收集文物</span><strong>${gameState.relics.length} 件</strong></p>
                    <p><span>🎯 做出选择</span><strong>${gameState.history.length} 次</strong></p>
                    <div style="margin-top:12px; text-align:center;">${relicsHtml}</div>
                </div>
                <div style="font-size:1.1rem; line-height:1.8; margin:20px 0; color:#3b2a14;">
                    <strong>“江山就是人民，人民就是江山。”</strong><br>
                    打江山、守江山，守的是人民的心。<br>
                    中国共产党根基在人民、血脉在人民、力量在人民。<br>
                    <span style="color:#a34e1e; font-weight:800; font-size:1.3rem;">人民至上，国家兴旺！</span>
                </div>
                <button class="restart-btn" onclick="restartGame()">🔄 重新答卷</button>
            </div>
        `;
    }

    // ==================== 重新开始 ====================
    function restartGame() {
        gameState.peopleHeart = 50;
        gameState.currentScene = 'prologue';
        gameState.currentStep = 0;
        gameState.relics = [];
        gameState.history = [];
        updateBalanceUI();
        renderScene();
    }

    // ==================== 初始化 ====================
    window.onload = function() {
        updateBalanceUI();
        renderScene();
    };
</script>
